{
  "_comment": "Copy this to ~/.config/devassist/mcp.json (or set DEVASSIST_MCP_CONFIG env var).",
  "_comment2": "Each server block is a stdio MCP server. Add/remove servers freely.",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_your_token_here"
      }
    },
    "clickup": {
      "command": "npx",
      "args": ["-y", "clickup-mcp-server"],
      "env": {
        "CLICKUP_API_TOKEN": "pk_your_token_here"
      }
    },
    "harvest": {
      "command": "npx",
      "args": ["-y", "harvest-mcp"],
      "env": {
        "HARVEST_ACCESS_TOKEN": "your_token",
        "HARVEST_ACCOUNT_ID": "your_account_id"
      }
    },
    "filesystem": {
      "_comment": "Optional: let the AI read local files / codebases",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/you/projects"],
      "env": {}
    }
  }
}
