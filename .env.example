# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any model on OpenRouter — swap anytime, no code change needed.
# Examples:
#   anthropic/claude-opus-4-6
#   anthropic/claude-sonnet-4-6
#   openai/gpt-4o
#   google/gemini-pro-1.5
#   meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=anthropic/claude-opus-4-6

# ─── MCP servers ─────────────────────────────────────────────────────────────
# Path to your MCP server config (defaults below, in priority order):
#   1. $DEVASSIST_MCP_CONFIG
#   2. ~/.config/devassist/mcp.json
#   3. ./.devassist-mcp.json
#
# See .devassist-mcp.example.json for the config format.
# DEVASSIST_MCP_CONFIG=/path/to/mcp.json

# ─── App ─────────────────────────────────────────────────────────────────────
# SQLite database path (for the built-in memory server: PR↔ticket links, sync rules)
DB_PATH=./data/devassist.db
