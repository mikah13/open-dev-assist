# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ClickUp
CLICKUP_API_KEY=pk_...
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=              # default list for your tickets

# GitHub
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=                 # your org or username
GITHUB_REPO=                  # default repo

# Harvest
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
HARVEST_PROJECT_ID=           # default project for time tracking
HARVEST_TASK_ID=              # default task ID for development

# App config
DB_PATH=~/.dev-assist/memory.db
DEFAULT_HOURS_PER_DAY=8
